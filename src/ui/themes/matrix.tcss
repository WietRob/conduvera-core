/* Matrix OS Theme - Enhanced Rich Style */

Screen {
    background: #000000;  /* Pure black like Electron version */
}

/* Header and Footer */
Header {
    dock: top;
    background: #000000;
    color: #00FF00;
    text-style: bold;
    border: round #00FF00;
}

Footer {
    dock: bottom;
    background: #000000;
    color: #00FF00;
    border: round #00FF00;
}

/* Windows - Rich-inspired panels */
.window {
    border: round #00FF00;  /* Rounded corners like Rich */
    background: rgba(0, 20, 0, 0.8);
    padding: 1 2;
}

.window-title {
    background: #00FF00;
    color: #000000;
    text-style: bold;
    padding: 0 1;
}

.window:focus {
    border: round #00FF00;
    background: rgba(0, 30, 0, 0.9);
}

.window-focused {
    border: heavy #00FF00;
}

/* Containers - Rich-style panels */
Container {
    background: rgba(0, 0, 0, 0.5);
    border: round #00AA00;
}

Horizontal {
    height: auto;
}

Vertical {
    width: auto;
}

/* Widgets */
MatrixRain {
    background: #000000;
    border: none;
}

Static {
    background: $panel;
    color: $text;
    padding: 1;
}

.status-panel {
    background: rgba(0, 20, 0, 0.7);
    border: round #00FF00;  /* Rich-style rounded borders */
    padding: 1;
    margin: 1;
}

/* Buttons - Rich-inspired with emojis */
Button {
    background: rgba(0, 100, 0, 0.5);
    color: #00FF00;
    border: round #00AA00;
    margin: 1;
    min-width: 16;
    text-style: bold;
}

Button:hover {
    background: #00FF00;
    color: #000000;
    text-style: bold;
    border: heavy #00FF00;
}

Button:focus {
    background: rgba(0, 150, 0, 0.8);
    color: #FFFFFF;
    border: heavy #00FF00;
}

Button.-primary {
    background: #00DD00;
    color: #000000;
    text-style: bold;
    border: heavy #00FF00;
}

/* Input */
Input {
    background: $surface;
    border: solid $success-darken-1;
    color: $text;
    margin: 1 0;
}

Input:focus {
    border: solid $success;
}

Input.-invalid {
    border: solid $error;
}

/* Labels */
Label {
    background: transparent;
    color: $text;
    padding: 0 1;
}

.label-success {
    color: $success;
    text-style: bold;
}

.label-error {
    color: $error;
    text-style: bold;
}

.label-warning {
    color: $warning;
    text-style: bold;
}

/* Tree (File Browser) */
Tree {
    background: $panel;
    color: $text;
    border: solid $success;
    scrollbar-background: $panel-darken-1;
    scrollbar-color: $success;
}

Tree:focus {
    border: solid $success-lighten-1;
}

Tree > .tree--guides {
    color: $success-darken-1;
}

Tree > .tree--cursor {
    background: $success-darken-2;
    text-style: bold;
}

/* DataTable (Process Monitor) */
DataTable {
    background: $panel;
    color: $text;
    border: solid $success;
}

DataTable:focus {
    border: solid $success-lighten-1;
}

DataTable > .datatable--header {
    background: $success-darken-1;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $success-darken-2;
}

/* RichLog (Terminal) */
RichLog {
    background: #000000;
    color: #00FF00;
    border: solid $success;
    padding: 1;
    scrollbar-background: $panel-darken-1;
    scrollbar-color: $success;
}

RichLog:focus {
    border: solid $success-lighten-1;
}

/* TextArea (Code Editor) */
TextArea {
    background: $surface;
    color: $text;
    border: solid $success;
    padding: 0 1;
}

TextArea:focus {
    border: solid $success-lighten-1;
}

TextArea > .text-area--cursor {
    background: $success;
    color: $surface;
}

/* Tabs */
Tabs {
    background: $panel;
    border: solid $success-darken-1;
}

Tab {
    background: $panel-darken-1;
    color: $text;
}

Tab:hover {
    background: $success-darken-2;
}

Tab.-active {
    background: $success-darken-1;
    text-style: bold;
}

/* Progress Bar */
ProgressBar {
    background: $panel;
    color: $success;
    bar-color: $success;
}

ProgressBar > .bar--complete {
    background: $success;
}

ProgressBar > .bar--indeterminate {
    background: $success;
}

/* Loading Indicator */
LoadingIndicator {
    background: transparent;
    color: $success;
}

/* Placeholder */
Placeholder {
    background: $panel-darken-2;
    color: $success-darken-1;
    border: dashed $success-darken-2;
}

/* Scrollbars */
Scrollbar {
    background: $panel-darken-1;
    color: $success;
}

Scrollbar:hover {
    background: $panel;
}

/* Tooltips */
Tooltip {
    background: $panel;
    color: $text;
    border: solid $success;
    padding: 1;
}

/* Specific widget overrides - Enhanced Matrix Style */
#main-container {
    background: #000000;  /* Pure black background */
}

#sidebar {
    background: rgba(0, 20, 0, 0.6);
    border-right: heavy #00FF00;  /* Prominent border like Rich */
    width: 30;
}

Sidebar {
    background: rgba(0, 20, 0, 0.6);
    border-right: heavy #00FF00;
    padding: 1;
}

.sidebar-title {
    background: transparent;
    color: #00FF00;
    text-style: bold;
    padding: 1 0;
}

#content-area {
    background: #000000;  /* Pure black for Matrix rain effect */
}

#welcome-container {
    background: rgba(0, 30, 0, 0.8);
    border: round #00FF00;
    padding: 2;
    margin: 2;
}

#welcome-message {
    color: #00FF00;
    text-align: center;
}

#status-bar {
    dock: bottom;
    background: rgba(0, 100, 0, 0.8);
    color: #00FF00;
    height: 1;
    padding: 0 1;
}

/* View system */
#view-container {
    background: transparent;
    width: 100%;
    height: 100%;
    padding: 0;
}

.view {
    width: 100%;
    height: 100%;
}

#file-browser-view {
    background: rgba(0, 20, 0, 0.8);
}

#process-monitor-view {
    background: rgba(0, 20, 0, 0.8);
}

#system-info-view {
    background: rgba(0, 20, 0, 0.8);
}

SystemInfoPanel {
    background: rgba(0, 20, 0, 0.8);
    border: round #00FF00;
    padding: 2;
}
